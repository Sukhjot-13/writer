# Copy to .env.local and fill in. Never commit real values.
# See README.md § "Manager integration" for what each block does.

# --- App (existing) ---------------------------------------------------------
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# SESSION_SECRET=<32+ char random string>
# RESEND_API_KEY=<your key>
# BREVO_API_KEY=<your key>
# BREVO_SENDER_EMAIL="Writer <noreply@example.com>"
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Manager (OPTIONAL — centralized logs + analytics) -----------------------
# Leave these unset and the app behaves exactly as before: the integration
# module turns into no-ops. Set them (locally or in Vercel) to enable it.
#
# Base URL of your Manager deployment (no trailing slash, not this app's port)
# MANAGER_ENDPOINT=https://manager.example.com
# Must match the project slug in Manager
# MANAGER_APP_ID=writer
# Server-side log key  -> Project > API keys > kind "server"  (mlk_…)
# MANAGER_LOG_KEY=mlk_replace_me
# Analytics tracker key -> Project > API keys > kind "analytics" (mak_…)
# MANAGER_ANALYTICS_KEY=mak_replace_me
# Optional: override the source label (defaults to "server")
# MANAGER_LOG_SOURCE=server

# Browser values. Next.js only inlines process.env.NEXT_PUBLIC_* when written as a
# static member access, so these are read that way and must be prefixed.
# NEXT_PUBLIC_MANAGER_ENDPOINT=https://manager.example.com
# NEXT_PUBLIC_MANAGER_APP_ID=writer
# NEXT_PUBLIC_MANAGER_CLIENT_KEY=mck_replace_me
# NEXT_PUBLIC_MANAGER_ANALYTICS_KEY=mak_replace_me
