{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": { "@/*": ["*"] },
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": [
    "./smoke-m2.ts",
    "./smoke-m3.ts",
    "./smoke-m4.ts",
    "./smoke-m5.ts",
    "./smoke-m6.ts",
    "../lib/**/*.ts",
    "../components/CopyDialog.tsx",
    "../app/api/documents/import-html/route.ts"
  ]
}
