# Writer app environment variables (requirements §12 / Plan §16)

# AI (M3) — only needed for AI conversion mode; Template mode works without it
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Storage
DATA_DIR=./data

# Vercel deploy only (FR-44 — MongoDB backend, ResumeBuilder pattern).
# BLOB_READ_WRITE_TOKEN is NO LONGER needed (2026-08-13): html/pdf render on
# demand and the instructions snapshot rides on the document — nothing is
# pre-generated into Vercel Blob anymore.
MONGODB_URI=
