# Writer app environment variables

# AI (M3) — only needed for AI conversion mode; Template mode works without it
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Storage (REQUIRED since 2026-08-13 — the filesystem backend was removed: serverless
# filesystems are read-only, so production is MongoDB-only and local dev needs it too)

# Required for local dev AND Vercel (FR-44 — MongoDB backend, ResumeBuilder pattern).
# BLOB_READ_WRITE_TOKEN is NO LONGER needed (2026-08-13): html/pdf render on
# demand and the instructions snapshot rides on the document — nothing is
# pre-generated into Vercel Blob anymore. MONGODB_URI is the ONLY storage config.
MONGODB_URI=

# Email (2026-09-28 — passwordless sign-in). BOTH are required: the app THROWS
# when either is missing rather than defaulting, so a misconfigured deploy fails
# loudly instead of silently sending nothing. Read in lib/auth.ts (sendOtpEmail).
#   BREVO_API_KEY      — the Brevo REST api-key header value
#   BREVO_SENDER_EMAIL — a verified sender in your Brevo account (the "from")
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
